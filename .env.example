# Django Configuration
SECRET_KEY=django-insecure-marsh-case-study-pitch-generator-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# LLM Configuration (OpenAI-compatible / Groq / GCP)
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Qdrant Vector Database
# Options:
# 1. Local Qdrant instance: http://localhost:6333
# 2. Qdrant Cloud: https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
# 3. In-memory (for local dev/testing without Docker): :memory:
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=policy_documents

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5


